rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function myPlayer() {
      return myProfile().playerId;
    }

    // Peter is de beschermde eigenaar. Nieuwe accounts krijgen altijd een p_<authUid>-id
    // en kunnen deze identiteit dus nooit verkrijgen.
    function isOwner() {
      return hasProfile() && myPlayer() == 'u-peter';
    }

    function isAdmin() {
      return hasProfile()
        && (isOwner() || myProfile().get('role', 'user') == 'admin');
    }

    function groupExists(groupId) {
      return groupId is string
        && groupId.size() > 0
        && exists(/databases/$(database)/documents/groups/$(groupId));
    }


    // Fase 2: nieuw persoons-/membershipmodel naast de legacy groepskoppeling.
    function ownsPlayer(playerId) {
      return hasProfile() && myPlayer() == playerId
        && exists(/databases/$(database)/documents/players/$(playerId))
        && get(/databases/$(database)/documents/players/$(playerId)).data.authUid == request.auth.uid;
    }
    function membershipPath(groupId, playerId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(playerId);
    }
    function membershipIndexPath(groupId, playerId) {
      return /databases/$(database)/documents/playerMemberships/$(playerId)/groups/$(groupId);
    }
    function indexAfterMatches(groupId, playerId) {
      return existsAfter(membershipIndexPath(groupId, playerId))
        && getAfter(membershipIndexPath(groupId, playerId)).data.groupId == groupId
        && getAfter(membershipIndexPath(groupId, playerId)).data.role == request.resource.data.role
        && getAfter(membershipIndexPath(groupId, playerId)).data.status == request.resource.data.status
        && getAfter(membershipIndexPath(groupId, playerId)).data.joinedAt == request.resource.data.get('joinedAt',0);
    }
    function approvedMember(groupId, playerId) {
      return exists(membershipPath(groupId, playerId))
        && get(membershipPath(groupId, playerId)).data.status == 'approved';
    }
    function groupAdmin(groupId, playerId) {
      return approvedMember(groupId, playerId)
        && get(membershipPath(groupId, playerId)).data.role == 'admin';
    }
    function validMembership(playerId) {
      return request.resource.data.keys().hasOnly([
          'playerId','displayName','role','status','requestedAt','approvedAt','joinedAt','approvedByPlayerId','updatedAt'
        ])
        && request.resource.data.keys().hasAll(['playerId','role','status','requestedAt','updatedAt'])
        && request.resource.data.playerId == playerId
        && request.resource.data.get('displayName','') is string
        && request.resource.data.get('displayName','').size() <= 30
        && request.resource.data.role in ['member','admin']
        && request.resource.data.status in ['pending','approved','rejected','left']
        && request.resource.data.requestedAt is int && request.resource.data.requestedAt >= 0
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= request.resource.data.requestedAt
        && request.resource.data.get('approvedAt', 0) is int && request.resource.data.get('approvedAt', 0) >= 0
        && request.resource.data.get('joinedAt', 0) is int && request.resource.data.get('joinedAt', 0) >= 0
        && request.resource.data.get('approvedByPlayerId', '') is string;
    }

    function validResult(id) {
      return hasProfile()
        && ownsPlayer(myPlayer())
        && request.resource.data.keys().hasOnly([
          'name','group','date','type','secs','uid','mist','hints','hintSteps','emo','note','completedOn'
        ])
        && request.resource.data.keys().hasAll([
          'name','group','date','type','secs','uid'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.group is string
        && approvedMember(request.resource.data.group, myPlayer())
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 10
        && (!('completedOn' in request.resource.data) || (
          request.resource.data.completedOn is string
          && request.resource.data.completedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ))
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 80
        && request.resource.data.uid is string
        && request.resource.data.uid == myPlayer()
        && id == request.resource.data.group + '_' + request.resource.data.date + '_' + request.resource.data.type + '_' + request.resource.data.uid
        && request.resource.data.secs is int
        && request.resource.data.secs > 0
        && request.resource.data.get('mist', 0) is int
        && request.resource.data.get('mist', 0) >= 0
        && request.resource.data.get('hints', 0) is int
        && request.resource.data.get('hints', 0) >= 0
        && (!('hintSteps' in request.resource.data) || (
          request.resource.data.hintSteps is map
          && request.resource.data.hintSteps.keys().hasOnly(['look','reason','move','legacy'])
          && request.resource.data.hintSteps.keys().hasAll(['look','reason','move','legacy'])
          && request.resource.data.hintSteps.look is int && request.resource.data.hintSteps.look >= 0
          && request.resource.data.hintSteps.reason is int && request.resource.data.hintSteps.reason >= 0
          && request.resource.data.hintSteps.move is int && request.resource.data.hintSteps.move >= 0
          && request.resource.data.hintSteps.legacy is int && request.resource.data.hintSteps.legacy >= 0
          && request.resource.data.hintSteps.look + request.resource.data.hintSteps.reason
             + request.resource.data.hintSteps.move + request.resource.data.hintSteps.legacy == request.resource.data.get('hints', 0)
        ))
        && request.resource.data.get('emo', '') is string
        && request.resource.data.get('emo', '').size() <= 8
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 80;
    }

    function validStatus(id) {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          'uid','group','name','date','type','at','progress','onlineAt',
          'onlineType','onlinePractice','onlineLvl','onlineNono','onlineView'
        ])
        && request.resource.data.keys().hasAll(['uid','group'])
        && request.resource.data.uid is string
        && request.resource.data.uid == myPlayer()
        && request.resource.data.group is string
        && approvedMember(request.resource.data.group, myPlayer())
        && id == request.resource.data.group + '_' + request.resource.data.uid
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 30
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('date', '').size() <= 10
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('type', '').size() <= 20
        && request.resource.data.get('at', 0) is int
        && request.resource.data.get('at', 0) >= 0
        && request.resource.data.get('onlineAt', 0) is int
        && request.resource.data.get('onlineAt', 0) >= 0
        && request.resource.data.get('onlineType', '') is string
        && request.resource.data.get('onlineType', '') in [
          '','bin','star','nono','kak','hex','plus','mur','m24'
        ]
        && request.resource.data.get('onlinePractice', false) is bool
        && request.resource.data.get('onlineLvl', 0) is int
        && request.resource.data.get('onlineLvl', 0) >= 0
        && request.resource.data.get('onlineLvl', 0) <= 6
        && request.resource.data.get('onlineNono', '') is string
        && request.resource.data.get('onlineNono', '') in ['','classic','color']
        && request.resource.data.get('onlineView', '') is string
        && request.resource.data.get('onlineView', '') in ['','home','puzzle']
        && request.resource.data.get('progress', {}) is map;
    }

    // Fase 2-skelet: stabiele speleridentiteit. Legacy profiles blijven de huidige app bedienen.
    match /players/{playerId} {
      allow get: if ownsPlayer(playerId);
      allow list: if false;
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.authUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.playerId == playerId
        && request.resource.data.keys().hasOnly(['playerId','authUid','displayName','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['playerId','authUid','displayName','createdAt','updatedAt'])
        && request.resource.data.playerId == playerId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 30
        && request.resource.data.createdAt is int && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= request.resource.data.createdAt;
      allow update: if ownsPlayer(playerId)
        && request.resource.data.keys().hasOnly(['playerId','authUid','displayName','createdAt','updatedAt'])
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 30
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if false;
    }

    // Fase 4: persoonlijke resultaten zijn canonical voor nieuwe writes; legacy /results blijft leesbaar.
    match /playerResults/{playerId}/items/{resultId} {
      allow read: if ownsPlayer(playerId);
      allow create, update: if ownsPlayer(playerId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion','playerId','name','groupId','puzzleDate','completedOn','puzzleType',
          'resultType','mode','difficulty','variant','deviceVariant','puzzleKey','secs',
          'mist','hints','hintSteps','emo','note','legacyResultId','completedAt','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion','playerId','name','puzzleDate','puzzleType','resultType','mode',
          'difficulty','puzzleKey','secs','createdAt','updatedAt'
        ])
        && request.resource.data.schemaVersion == 3
        && request.resource.data.playerId == playerId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.get('groupId','') is string
        && request.resource.data.puzzleDate is string && request.resource.data.puzzleDate.size() <= 10
        && request.resource.data.get('completedOn','') is string && request.resource.data.get('completedOn','').size() <= 10
        && request.resource.data.puzzleType is string && request.resource.data.puzzleType.size() > 0
        && request.resource.data.resultType is string && request.resource.data.resultType.size() > 0 && request.resource.data.resultType.size() <= 80
        && request.resource.data.mode in ['daily','free']
        && request.resource.data.difficulty is string
        && request.resource.data.get('variant','') is string
        && request.resource.data.get('deviceVariant','') is string
        && request.resource.data.puzzleKey is string && request.resource.data.puzzleKey.size() > 0
        && request.resource.data.secs is int && request.resource.data.secs > 0
        && request.resource.data.get('mist',0) is int && request.resource.data.get('mist',0) >= 0
        && request.resource.data.get('hints',0) is int && request.resource.data.get('hints',0) >= 0
        && request.resource.data.get('emo','') is string && request.resource.data.get('emo','').size() <= 8
        && request.resource.data.get('note','') is string && request.resource.data.get('note','').size() <= 80
        && request.resource.data.get('legacyResultId','') is string
        && request.resource.data.get('completedAt', request.resource.data.createdAt) is int
        && request.resource.data.get('completedAt', request.resource.data.createdAt) > 0
        && request.resource.data.createdAt is int && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= request.resource.data.createdAt;
      allow delete: if ownsPlayer(playerId);
    }

    // Fase 4: persoonlijke voortgang; legacy status.progress blijft tijdelijk compatibel leesbaar.
    // Fase 8: afgeleide sociale read-index. Persoonlijke playerResults blijven canonical.
    // Een projectie mag alleen door de speler zelf worden geschreven, voor een approved membership,
    // en nooit voor activiteit van vóór joinedAt. Daardoor kan een nieuw groepslid geen oude historie delen.
    match /groupActivity/{groupId}/items/{activityId} {
      allow get, list: if hasProfile() && ownsPlayer(myPlayer()) && approvedMember(groupId, myPlayer());
      allow create, update: if hasProfile()
        && ownsPlayer(request.resource.data.playerId)
        && approvedMember(groupId, request.resource.data.playerId)
        && request.resource.data.groupId == groupId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.completedAt is int
        && request.resource.data.completedAt >= get(membershipPath(groupId, request.resource.data.playerId)).data.joinedAt
        && request.resource.data.keys().hasOnly([
          'schemaVersion','groupId','playerId','name','puzzleDate','completedOn','puzzleType',
          'resultType','mode','difficulty','variant','deviceVariant','puzzleKey','secs',
          'mist','hints','hintSteps','completedAt'
        ])
        && request.resource.data.secs is int && request.resource.data.secs > 0;
      allow delete: if ownsPlayer(resource.data.playerId);
    }

    match /groupDailyPlans/{groupId}/items/{planId} {
      allow get, list: if hasProfile() && ownsPlayer(myPlayer()) && approvedMember(groupId, myPlayer());
      allow create: if hasProfile()
        && ownsPlayer(request.resource.data.playerId)
        && approvedMember(groupId, request.resource.data.playerId)
        && request.resource.data.groupId == groupId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is int
        && request.resource.data.sharedAt is int
        && request.resource.data.sharedAt >= get(membershipPath(groupId, request.resource.data.playerId)).data.joinedAt
        && request.resource.data.favoritePuzzleTypes is list
        && request.resource.data.difficulties is map;
      allow update: if ownsPlayer(resource.data.playerId)
        && approvedMember(groupId, resource.data.playerId)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.date == resource.data.date
        && request.resource.data.favoritePuzzleTypes == resource.data.favoritePuzzleTypes
        && request.resource.data.difficulties == resource.data.difficulties
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sharedAt is int
        && request.resource.data.sharedAt >= resource.data.get('sharedAt', resource.data.createdAt)
        && request.resource.data.sharedAt >= get(membershipPath(groupId, resource.data.playerId)).data.joinedAt;
      allow delete: if false;
    }

    match /progress/{playerId}/items/{progressId} {
      allow read: if ownsPlayer(playerId);
      allow create, update: if ownsPlayer(playerId)
        && request.resource.data.keys().hasOnly([
          'playerId','puzzleType','mode','puzzleKey','difficulty','variant','deviceVariant',
          'state','progressPercent','startedAt','updatedAt','schemaVersion','legacyKey'
        ])
        && request.resource.data.keys().hasAll([
          'playerId','puzzleType','mode','puzzleKey','difficulty','state','progressPercent','startedAt','updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['schemaVersion']) || request.resource.data.schemaVersion == 3)
        && (!request.resource.data.keys().hasAny(['legacyKey']) || request.resource.data.legacyKey is string)
        && request.resource.data.playerId == playerId
        && request.resource.data.puzzleType is string
        && request.resource.data.mode in ['daily','free']
        && request.resource.data.puzzleKey is string
        && request.resource.data.difficulty is string
        && request.resource.data.get('variant','') is string
        && request.resource.data.get('deviceVariant','') is string
        && request.resource.data.state is map
        && request.resource.data.progressPercent is int
        && request.resource.data.progressPercent >= 0 && request.resource.data.progressPercent <= 100
        && request.resource.data.startedAt is int && request.resource.data.startedAt >= 0
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= request.resource.data.startedAt;
      allow delete: if ownsPlayer(playerId);
    }

    // Fase 5: inverse index voor "mijn groepen". Canonical membership blijft groups/{groupId}/members/{playerId}.
    function validMembershipIndex(groupId) {
      return request.resource.data.keys().hasOnly(['groupId','role','status','joinedAt','updatedAt'])
        && request.resource.data.keys().hasAll(['groupId','role','status','joinedAt','updatedAt'])
        && request.resource.data.groupId == groupId
        && request.resource.data.role in ['member','admin']
        && request.resource.data.status in ['pending','approved','rejected','left']
        && request.resource.data.joinedAt is int && request.resource.data.joinedAt >= 0
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= 0;
    }
    function indexMatchesMembership(groupId, playerId) {
      return existsAfter(membershipPath(groupId, playerId))
        && getAfter(membershipPath(groupId, playerId)).data.role == request.resource.data.role
        && getAfter(membershipPath(groupId, playerId)).data.status == request.resource.data.status
        && getAfter(membershipPath(groupId, playerId)).data.get('joinedAt',0) == request.resource.data.joinedAt;
    }
    match /playerMemberships/{playerId}/groups/{groupId} {
      allow read: if ownsPlayer(playerId);
      allow create, update: if validMembershipIndex(groupId)
        && indexMatchesMembership(groupId, playerId)
        && (ownsPlayer(playerId) || groupAdmin(groupId, myPlayer()));
      allow delete: if (ownsPlayer(playerId) || groupAdmin(groupId, myPlayer()))
        && !existsAfter(membershipPath(groupId, playerId));
    }

    match /results/{id} {
      // Legacy resultaten blijven voor de eigenaar leesbaar. Sociale groepslezing loopt in Fase 8
      // via groupActivity, zodat joinedAt ook werkelijk door rules wordt afgedwongen.
      allow read: if isAdmin()
        || (hasProfile() && resource.data.uid == myPlayer());
      allow create: if validResult(id);
      allow update: if validResult(id)
        && resource.data.uid == myPlayer()
        && approvedMember(resource.data.group, myPlayer())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.group == resource.data.group
        && request.resource.data.date == resource.data.date
        && request.resource.data.type == resource.data.type;
      allow delete: if isOwner();
    }

    // Sociale presence bevat nooit een persoonlijk bord of legacy progress.
    match /presence/{id} {
      allow read: if isAdmin() || (hasProfile() && approvedMember(resource.data.group, myPlayer()));
      allow create, update: if validStatus(id) && ownsPlayer(myPlayer())
        && !request.resource.data.keys().hasAny(['progress']);
      allow delete: if ownsPlayer(resource.data.uid);
    }

    match /status/{id} {
      allow read: if isAdmin()
        || (hasProfile() && resource.data.uid == myPlayer());
      allow create: if validStatus(id);
      allow update: if validStatus(id)
        && resource.data.uid == myPlayer()
        && approvedMember(resource.data.group, myPlayer())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.group == resource.data.group;
      allow delete: if isOwner();
    }

    // Fase 7: een daily plan is een persoonlijke, onveranderlijke snapshot van de keuzes voor die datum.
    match /dailyPlans/{playerId}/days/{date} {
      allow get: if ownsPlayer(playerId);
      allow list: if ownsPlayer(playerId);
      allow create: if ownsPlayer(playerId)
        && request.resource.data.keys().hasOnly(['schemaVersion','playerId','date','favoritePuzzleTypes','difficulties','createdAt'])
        && request.resource.data.playerId == playerId
        && request.resource.data.date == date
        && request.resource.data.schemaVersion == 4
        && request.resource.data.favoritePuzzleTypes is list
        && request.resource.data.favoritePuzzleTypes.size() > 0
        && request.resource.data.favoritePuzzleTypes.size() <= 6
        && request.resource.data.difficulties is map
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0;
      allow update, delete: if false;
    }

    match /profiles/{authUid} {
      allow get: if signedIn() && (request.auth.uid == authUid || isAdmin());
      allow list: if isAdmin();

      // Een nieuw profiel kan alleen ontstaan uit een geldige, e-mailgebonden uitnodiging.
      allow create: if signedIn()
        && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly([
          'authUid','playerId','displayName','groupId','role',
          'createdAt','updatedAt','inviteCode','invitedByAuthUid','groupJoinCode','theme','accent','accountState','preferences'
        ])
        && request.resource.data.keys().hasAll([
          'authUid','playerId','displayName','groupId','role',
          'createdAt','updatedAt','inviteCode','invitedByAuthUid','groupJoinCode','theme','accent','accountState','preferences'
        ])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.playerId == 'p_' + request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.groupId == ''
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && request.resource.data.inviteCode is string
        && (
          request.resource.data.inviteCode == ''
          || (request.resource.data.inviteCode.size() >= 8 && request.resource.data.inviteCode.size() <= 12)
        )
        && request.resource.data.invitedByAuthUid is string
        && request.resource.data.groupJoinCode == ''
        && request.resource.data.theme in ['shared','peter','aart','stars','nature','retro','animals','sea','travel','music','party','coffee','season','minimal']
        && request.resource.data.accent in ['blue','purple','teal','green','orange','pink','red']
        && request.resource.data.accountState in ['anonymous','linked']
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'anonymous'
            && request.resource.data.accountState == 'anonymous'
            && request.resource.data.inviteCode == ''
            && request.resource.data.invitedByAuthUid == ''
          )
          || (
            request.auth.token.email_verified == true
            && request.resource.data.accountState == 'linked'
            && exists(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode)).data.createdByAuthUid == request.resource.data.invitedByAuthUid
            && get(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode)).data.usedByAuthUid == ''
            && get(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode)).data.revoked == false
            && get(/databases/$(database)/documents/accessInvites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
          )
        )
;

      // Gebruikers kunnen alleen hun eigen naam/groep wijzigen; rol en identiteit blijven vast.
      allow update: if (
          signedIn()
          && request.auth.uid == authUid
          && request.resource.data.keys().hasOnly([
            'authUid','playerId','displayName','groupId','role',
            'createdAt','updatedAt','inviteCode','invitedByAuthUid','groupJoinCode','theme','accent','accountState','preferences'
          ])
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.get('role','user') == resource.data.get('role','user')
          && request.resource.data.get('createdAt',0) == resource.data.get('createdAt',0)
          && request.resource.data.get('inviteCode','') == resource.data.get('inviteCode','')
          && request.resource.data.get('invitedByAuthUid','') == resource.data.get('invitedByAuthUid','')
          && request.resource.data.get('accountState','linked') in ['anonymous','linked']
          && (
            request.resource.data.get('accountState','linked') == resource.data.get('accountState','linked')
            || (
              resource.data.get('accountState','linked') == 'anonymous'
              && request.resource.data.accountState == 'linked'
              && request.auth.token.firebase.sign_in_provider != 'anonymous'
            )
          )
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 30
          && request.resource.data.get('theme','shared') in ['shared','peter','aart','stars','nature','retro','animals','sea','travel','music','party','coffee','season','minimal']
          && request.resource.data.get('accent','blue') in ['blue','purple','teal','green','orange','pink','red']
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}}) is map
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}}).keys().hasOnly(['favoritePuzzleTypes','dailyDifficulty','tutorials'])
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}}).get('favoritePuzzleTypes',[]) is list
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}}).get('favoritePuzzleTypes',[]).size() <= 6
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}, 'tutorials': {}}).get('dailyDifficulty',{}) is map
          && request.resource.data.get('preferences', {'favoritePuzzleTypes': [], 'dailyDifficulty': {}, 'tutorials': {}}).get('tutorials',{}) is map
          && request.resource.data.groupId is string
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0
        )
        // Alleen de eigenaar mag een ander user/admin maken. De eigenaar zelf is immuun.
        || (
          isOwner()
          && resource.data.playerId != 'u-peter'
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.get('createdAt',0) == resource.data.get('createdAt',0)
          && request.resource.data.get('inviteCode','') == resource.data.get('inviteCode','')
          && request.resource.data.get('invitedByAuthUid','') == resource.data.get('invitedByAuthUid','')
          && request.resource.data.get('groupJoinCode','') == resource.data.get('groupJoinCode','')
          && request.resource.data.get('theme','shared') == resource.data.get('theme','shared')
          && request.resource.data.get('accent','blue') == resource.data.get('accent','blue')
          && request.resource.data.get('preferences',{}) == resource.data.get('preferences',{})
          && request.resource.data.role in ['user','admin']
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0
        );

      allow delete: if isOwner() && resource.data.playerId != 'u-peter';
    }

    match /groups/{groupId}/members/{playerId} {
      allow get: if ownsPlayer(playerId)
        || (hasProfile() && ownsPlayer(myPlayer()) && approvedMember(groupId, myPlayer()));
      allow list: if hasProfile() && ownsPlayer(myPlayer())
        && (approvedMember(groupId, myPlayer()) || groupAdmin(groupId, myPlayer()));
      // Een speler kan zelf alleen pending aanvragen. Bij het aanmaken van een nieuwe groep mag
      // de maker in dezelfde batch de eerste approved admin worden.
      allow create: if validMembership(playerId)
        && indexAfterMatches(groupId, playerId)
        && (
          (ownsPlayer(playerId)
            && groupExists(groupId)
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'member'
            && request.resource.data.get('approvedAt', 0) == 0
            && request.resource.data.get('joinedAt', 0) == 0
            && request.resource.data.get('approvedByPlayerId', '') == '')
          ||
          (ownsPlayer(playerId)
            && !exists(/databases/$(database)/documents/groups/$(groupId))
            && request.resource.data.status == 'approved'
            && request.resource.data.role == 'admin'
            && request.resource.data.get('joinedAt',0) > 0
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerAuthUid == request.auth.uid)
        );
      // Iedere approved admin mag aanvragen goedkeuren en leden promoveren/demoveren.
      // Een admin kan zijn eigen approved-adminstatus niet verlagen of verwijderen. Daardoor
      // kan de laatste admin nooit verdwijnen; bij meerdere admins kan een andere admin dit doen.
      allow update: if validMembership(playerId)
        && indexAfterMatches(groupId, playerId)
        && hasProfile() && ownsPlayer(myPlayer()) && groupAdmin(groupId, myPlayer())
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.get('displayName','') == resource.data.get('displayName','')
        && request.resource.data.requestedAt == resource.data.requestedAt
        && (resource.data.status != 'approved' || request.resource.data.status != 'approved'
          || request.resource.data.joinedAt == resource.data.joinedAt)
        && (playerId != myPlayer()
          || (resource.data.status == 'approved' && resource.data.role == 'admin'
            && request.resource.data.status == 'approved' && request.resource.data.role == 'admin'));
      allow delete: if hasProfile() && ownsPlayer(myPlayer())
        && groupAdmin(groupId, myPlayer()) && playerId != myPlayer()
        && !existsAfter(membershipIndexPath(groupId, playerId));
    }

    match /groups/{groupId} {
      allow get: if (hasProfile() && approvedMember(groupId, myPlayer())) || isAdmin();
      allow list: if isAdmin();

      // Nieuwe groepen krijgen altijd een willekeurig id "g_…" (zoals de app ze maakt). Zo kan niemand
      // een groep aanmaken onder het id van een bestaande (oude) groep en zich daar eigenaar van maken.
      allow create: if hasProfile() && ownsPlayer(myPlayer())
        && existsAfter(membershipPath(groupId, myPlayer()))
        && getAfter(membershipPath(groupId, myPlayer())).data.status == 'approved'
        && getAfter(membershipPath(groupId, myPlayer())).data.role == 'admin'
        && groupId.matches('g_[a-z0-9]{6,20}')
        && request.resource.data.keys().hasOnly([
          'name','ownerAuthUid','inviteCode','theme','accent','murdokuNames','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','ownerAuthUid','inviteCode','theme','accent','murdokuNames','createdAt','updatedAt'
        ])
        && request.resource.data.ownerAuthUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 6
        && request.resource.data.inviteCode.size() <= 12
        && request.resource.data.theme in ['shared','peter','aart','stars','nature','retro','animals','sea','travel','music','party','coffee','season','minimal']
        && request.resource.data.accent in ['blue','purple','teal','green','orange','pink','red']
        && request.resource.data.murdokuNames is list
        && request.resource.data.murdokuNames.size() <= 18
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt >= 0
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;

      allow update: if signedIn()
        && hasProfile() && ownsPlayer(myPlayer()) && groupAdmin(groupId, myPlayer())
        && request.resource.data.keys().hasOnly([
          'name','ownerAuthUid','inviteCode','theme','accent','murdokuNames','createdAt','updatedAt'
        ])
        && request.resource.data.ownerAuthUid == resource.data.ownerAuthUid
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.get('theme','shared') in ['shared','peter','aart','stars','nature','retro','animals','sea','travel','music','party','coffee','season','minimal']
        && request.resource.data.get('accent','orange') in ['blue','purple','teal','green','orange','pink','red']
        && request.resource.data.get('murdokuNames',[]) is list
        && request.resource.data.get('murdokuNames',[]).size() <= 18
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;

      allow delete: if isOwner();
    }

    // Codes waarmee een bestaand Gepuzzellig-account naar een groep kan overstappen.
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if hasProfile()
        && ownsPlayer(myPlayer()) && groupAdmin(request.resource.data.groupId, myPlayer())
        && request.resource.data.keys().hasOnly([
          'groupId','ownerAuthUid','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'groupId','ownerAuthUid','createdAt'
        ])
        && request.resource.data.ownerAuthUid is string
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt >= 0
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerAuthUid == request.resource.data.ownerAuthUid
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;

      allow update: if false;
      allow delete: if isOwner();
    }

    // Uitnodigingen die toegang geven tot Gepuzzellig zelf.
    match /accessInvites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if hasProfile()
        && request.resource.data.suggestedGroupId is string
        && (request.resource.data.suggestedGroupId == '' || approvedMember(request.resource.data.suggestedGroupId, myPlayer()))
        && code == request.resource.data.code
        && request.resource.data.keys().hasOnly([
          'code','email','createdByAuthUid','createdByPlayerId','createdByName',
          'suggestedGroupId','suggestedGroupName','createdAt','expiresAt',
          'usedByAuthUid','usedAt','revoked'
        ])
        && request.resource.data.keys().hasAll([
          'code','email','createdByAuthUid','createdByPlayerId','createdByName',
          'suggestedGroupId','suggestedGroupName','createdAt','expiresAt',
          'usedByAuthUid','usedAt','revoked'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 120
        && request.resource.data.createdByAuthUid == request.auth.uid
        && request.resource.data.createdByPlayerId == myPlayer()
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 30
        && request.resource.data.suggestedGroupName is string
        && request.resource.data.suggestedGroupName.size() <= 40
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.usedByAuthUid == ''
        && request.resource.data.usedAt == 0
        && request.resource.data.revoked == false;

      allow update: if signedIn()
        && request.resource.data.code == resource.data.code
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdByAuthUid == resource.data.createdByAuthUid
        && request.resource.data.createdByPlayerId == resource.data.createdByPlayerId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.suggestedGroupId == resource.data.suggestedGroupId
        && request.resource.data.suggestedGroupName == resource.data.suggestedGroupName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.get('mailSentAt',0) == resource.data.get('mailSentAt',0)
        && (
          (
            resource.data.createdByAuthUid == request.auth.uid
            && resource.data.usedByAuthUid == ''
            && request.resource.data.usedByAuthUid == resource.data.usedByAuthUid
            && request.resource.data.usedAt == resource.data.usedAt
            && resource.data.revoked == false
            && request.resource.data.revoked == true
          )
          || (
            request.auth.token.email_verified == true
            && request.auth.token.email == resource.data.email
            && resource.data.usedByAuthUid == ''
            && resource.data.revoked == false
            && resource.data.expiresAt > request.time
            && request.resource.data.usedByAuthUid == request.auth.uid
            && request.resource.data.usedAt is int
            && request.resource.data.usedAt > 0
            && request.resource.data.revoked == false
          )
        );

      allow delete: if isOwner();
    }
  }
}
